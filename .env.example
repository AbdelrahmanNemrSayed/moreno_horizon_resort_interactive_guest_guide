# ==============================================================
# Moreno Horizon Spa & Resort - Environment Configuration
# Copy this file to .env and customize secrets for your environment
# ==============================================================

# Server Environment & Port
NODE_ENV=development
PORT=8080

# Security & Admin Access
# Set strong, unpredictable secrets in production
ADMIN_PASSWORD=Moreno@2026!
JWT_SECRET=moreno-resort-secret-key-change-in-production

# MikroTik RouterOS Live Tracking Feed
MIKROTIK_FEED_KEY=moreno-mikrotik-secure-feed-key

# MikroTik API Bridge Connection (for server/bridgeServer.js)
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=api_user
MIKROTIK_PASS=moreno_mikrotik_secret
MIKROTIK_POLL_INTERVAL_MS=1000
MIKROTIK_TIMEOUT_SEC=30
MIKROTIK_CACHE_SIZE=100
